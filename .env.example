# انسخ هذا الملف باسم .env وعبّئ القيم الحقيقية فيه — لا ترفع .env أبداً إلى GitHub
# (أو الأسهل: شغّل bash setup_env.sh وسيُنشئ لك .env تفاعلياً بأمان)

# ------------------------------------------------------------------
# OpenAI (إلزامي — هذا هو المتطلب الوحيد الفعلي لتشغيل البوت)
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# الموقع الإخباري الساكن (القناة الافتراضية — مفعّلة تلقائياً، لا تحتاج
# ووردبريس ولا استضافة، تُنشر مجاناً عبر GitHub Pages من مجلد docs/)
# ------------------------------------------------------------------
ENABLE_STATIC_SITE=true
SITE_TITLE=BloomEconomy — أخبار اقتصادية
# رابط الموقع بعد تفعيل GitHub Pages (يُملأ تلقائياً بواسطة enable_website.sh)
SITE_BASE_URL=

# ------------------------------------------------------------------
# إعلانات جوجل AdSense (اختياري — فعّله فقط بعد قبول حسابك في AdSense)
# ADSENSE_CLIENT_ID هو معرّف الناشر (يبدأ بـ ca-pub-) من لوحة تحكم AdSense
# ------------------------------------------------------------------
ENABLE_ADSENSE=false
ADSENSE_CLIENT_ID=

# ------------------------------------------------------------------
# ووردبريس (اختياري — فعّله فقط إن كان لديك موقع ووردبريس بالفعل)
# ------------------------------------------------------------------
ENABLE_WORDPRESS=false
WP_BASE_URL=https://yourwebsite.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
POST_STATUS=publish

# ------------------------------------------------------------------
# التشغيل ومنع التكرار
# ------------------------------------------------------------------
POLL_INTERVAL_MINUTES=30
# نسبة التشابه بين العناوين (0 إلى 1) لاعتبار خبرين "نفس الموضوع" وتخطي أحدهما
DUPLICATE_SIMILARITY_THRESHOLD=0.6
# نافذة البحث عن التشابه بالساعات (يقارن فقط بالأخبار المنشورة خلال هذه المدة)
DUPLICATE_WINDOW_HOURS=48

# ------------------------------------------------------------------
# تليجرام (اختياري) — ضع ENABLE_TELEGRAM=true لتفعيل النشر إلى قناة/مجموعة
# أنشئ بوتاً عبر @BotFather في تليجرام للحصول على TELEGRAM_BOT_TOKEN،
# وأضف البوت كمشرف في القناة للحصول على TELEGRAM_CHAT_ID (مثال: @my_channel أو -100xxxxxxxxxx)
# ------------------------------------------------------------------
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------
# إشعارات الفشل (اختياري) — تُرسل عبر نفس بوت تليجرام أعلاه إلى محادثتك الخاصة
# TELEGRAM_ADMIN_CHAT_ID: معرّف محادثتك الشخصية مع البوت (اتركه فارغاً لاستخدام TELEGRAM_CHAT_ID نفسه)
# ------------------------------------------------------------------
ENABLE_NOTIFICATIONS=false
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------
# منصة X (تويتر سابقاً) — مُعطّلة افتراضياً، جاهزة للتفعيل لاحقاً فقط
# يتطلب حساب مطوّر على X API وتثبيت مكتبة tweepy (pip install tweepy)
# ------------------------------------------------------------------
ENABLE_X=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
