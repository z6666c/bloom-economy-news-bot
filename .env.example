# انسخ هذا الملف باسم .env وعبّئ القيم الحقيقية فيه — لا ترفع .env أبداً إلى GitHub

# مفتاح OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# بيانات موقع ووردبريس
WP_BASE_URL=https://yourwebsite.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# publish للنشر مباشرة أو draft لحفظها كمسودة للمراجعة
POST_STATUS=publish

# الفاصل الزمني بين دورات الفحص (بالدقائق) — يُستخدم فقط في وضع التشغيل المستمر
POLL_INTERVAL_MINUTES=30

# اسم نموذج OpenAI المستخدم لإعادة الصياغة والترجمة
OPENAI_MODEL=gpt-4o-mini
